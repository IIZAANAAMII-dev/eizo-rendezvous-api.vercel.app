{% comment %}
  EIZO Booking Widget v2.2 - Custom Liquid Modal
  Copier-coller dans un block "Custom Liquid" sur les pages produits ColorEdge.
{% endcomment %}

<style>
  #eizo-booking-widget { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
  #eizo-booking-widget .eizo-trigger { display: inline-flex; align-items: center; gap: 10px; padding: 14px 28px; background: #0066CC; color: #fff; border: none; border-radius: 10px; font-size: 15px; font-weight: 600; cursor: pointer; transition: filter .2s; }
  #eizo-booking-widget .eizo-trigger:hover { filter: brightness(0.93); }
  #eizo-booking-widget .eizo-backdrop { display: none; position: fixed; inset: 0; z-index: 9999; align-items: center; justify-content: center; background: rgba(11,18,32,0.45); backdrop-filter: blur(4px); padding: 16px; }
  #eizo-booking-widget .eizo-backdrop.active { display: flex; }
  #eizo-booking-widget .eizo-modal { background: #fff; border-radius: 20px; width: min(960px, 100%); max-height: calc(100vh - 32px); box-shadow: 0 25px 60px rgba(0,0,0,0.18); overflow: hidden; display: grid; grid-template-columns: 300px 1fr; transform: scale(0.96); opacity: 0; transition: all .3s cubic-bezier(.16,1,.3,1); }
  #eizo-booking-widget .eizo-backdrop.active .eizo-modal { transform: scale(1); opacity: 1; }
  #eizo-booking-widget .eizo-sidebar { background: #F6F8FB; padding: 32px 28px; border-right: 1px solid #E3E8EF; display: flex; flex-direction: column; gap: 18px; overflow-y: auto; }
  #eizo-booking-widget .eizo-avatar { width: 96px; height: 96px; border-radius: 50%; background: #0066CC; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 28px; font-weight: 700; overflow: hidden; }
  #eizo-booking-widget .eizo-avatar img { width: 100%; height: 100%; object-fit: cover; }
  #eizo-booking-widget .eizo-name { font-size: 22px; font-weight: 700; color: #0B1220; margin: 0; }
  #eizo-booking-widget .eizo-specialty { color: #0066CC; font-weight: 600; font-size: 14px; margin: 0; }
  #eizo-booking-widget .eizo-profile { font-size: 13px; line-height: 1.55; color: #5E6A7E; }
  #eizo-booking-widget .eizo-profile-section { margin-bottom: 14px; padding-bottom: 14px; border-bottom: 1px solid #E3E8EF; }
  #eizo-booking-widget .eizo-profile-section:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
  #eizo-booking-widget .eizo-profile-label { font-weight: 700; color: #0B1220; margin: 0 0 6px; text-transform: uppercase; letter-spacing: 0.4px; }
  #eizo-booking-widget .eizo-profile-line { margin: 0 0 5px; }
  #eizo-booking-widget .eizo-link { color: #0066CC; text-decoration: none; font-weight: 500; }
  #eizo-booking-widget .eizo-link:hover { text-decoration: underline; }
  #eizo-booking-widget .eizo-mute { color: #8B95A8; }
  #eizo-booking-widget .eizo-logos { margin-top: auto; padding-top: 12px; }
  #eizo-booking-widget .eizo-logos-wrap { display: flex; align-items: center; justify-content: center; gap: 16px; background: #fff; border-radius: 12px; padding: 16px; border: 1px solid #E3E8EF; }
  #eizo-booking-widget .eizo-logo { max-height: 42px; width: auto; max-width: 100%; object-fit: contain; }
  #eizo-booking-widget .eizo-close { position: absolute; top: 20px; right: 20px; width: 40px; height: 40px; border: none; background: #F6F8FB; border-radius: 50%; cursor: pointer; font-size: 22px; color: #5E6A7E; transition: background .2s, color .2s, transform .2s; }
  #eizo-booking-widget .eizo-close:hover { background: #0066CC; color: #fff; transform: rotate(90deg); }
  #eizo-booking-widget .eizo-main { padding: 32px; overflow-y: auto; position: relative; }
  #eizo-booking-widget .eizo-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
  #eizo-booking-widget .eizo-header h2 { margin: 0; font-size: 20px; color: #0B1220; }
  #eizo-booking-widget .eizo-nav { display: flex; gap: 8px; align-items: center; }
  #eizo-booking-widget .eizo-nav button { width: 34px; height: 34px; border: 1px solid #E3E8EF; background: #fff; border-radius: 8px; cursor: pointer; font-size: 16px; }
  #eizo-booking-widget .eizo-month { font-weight: 700; min-width: 140px; text-align: center; }
  #eizo-booking-widget .eizo-calendar { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-bottom: 24px; }
  #eizo-booking-widget .eizo-day-label { text-align: center; font-size: 12px; font-weight: 700; color: #5E6A7E; padding: 8px 0; }
  #eizo-booking-widget .eizo-day { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-radius: 12px; cursor: pointer; font-size: 14px; background: #F6F8FB; color: #0B1220; border: 1px solid transparent; transition: all .2s; }
  #eizo-booking-widget .eizo-day:hover:not(.disabled):not(.empty) { border-color: #0066CC; background: rgba(0,102,204,0.08); }
  #eizo-booking-widget .eizo-day.disabled { color: #6B7280; cursor: not-allowed; background: #E5E7EB; pointer-events: none; opacity: 0.55; }
  #eizo-booking-widget .eizo-day.empty { background: transparent; cursor: default; }
  #eizo-booking-widget .eizo-day.selected { background: #0066CC; color: #fff; }
  #eizo-booking-widget .eizo-slots-title { font-size: 15px; font-weight: 700; margin-bottom: 12px; }
  #eizo-booking-widget .eizo-slots { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
  #eizo-booking-widget .eizo-slot { padding: 12px; border: 1.5px solid #E3E8EF; background: #fff; border-radius: 10px; text-align: center; cursor: pointer; font-weight: 600; }
  #eizo-booking-widget .eizo-slot:hover { border-color: #0066CC; color: #0066CC; background: rgba(0,102,204,0.05); }
  #eizo-booking-widget .eizo-slot.eizo-disabled { color: #9CA3AF; background: #F3F4F6; border-color: #E5E7EB; cursor: not-allowed; opacity: 0.7; }
  #eizo-booking-widget .eizo-form { margin-top: 20px; }
  #eizo-booking-widget .eizo-form h4 { margin: 0 0 6px; }
  #eizo-booking-widget .eizo-form p { color: #5E6A7E; margin: 0 0 18px; }
  #eizo-booking-widget .eizo-form label { display: block; font-size: 13px; font-weight: 700; margin-bottom: 4px; }
  #eizo-booking-widget .eizo-form input,
  #eizo-booking-widget .eizo-form select,
  #eizo-booking-widget .eizo-form textarea { width: 100%; padding: 12px; border: 1px solid #E3E8EF; border-radius: 10px; margin-bottom: 14px; font-size: 15px; box-sizing: border-box; background: #fff; }
  #eizo-booking-widget .eizo-form button { width: 100%; padding: 14px; border: none; background: #0066CC; color: #fff; font-size: 16px; font-weight: 700; border-radius: 10px; cursor: pointer; }
  #eizo-booking-widget .eizo-form button:hover { filter: brightness(0.93); }
  #eizo-booking-widget .eizo-error { color: #EF4444; font-size: 14px; margin-bottom: 12px; }
  #eizo-booking-widget .eizo-success { text-align: center; padding: 40px 20px; color: #0B1220; }
  #eizo-booking-widget .eizo-success .icon { width: 72px; height: 72px; border-radius: 50%; background: rgba(16,185,129,0.1); color: #10B981; display: flex; align-items: center; justify-content: center; font-size: 36px; margin: 0 auto 24px; }
  #eizo-booking-widget .eizo-prompt { display: flex; position: fixed; inset: 0; z-index: 10000; align-items: center; justify-content: center; background: rgba(11,18,32,0.35); backdrop-filter: blur(12px); padding: 16px; visibility: hidden; opacity: 0; transition: visibility .4s ease, opacity .4s ease; }
  #eizo-booking-widget .eizo-prompt.active { visibility: visible; opacity: 1; }
  #eizo-booking-widget .eizo-prompt-card { position: relative; width: min(360px, 100%); background: rgba(255,255,255,0.97); border-radius: 24px; box-shadow: 0 24px 60px rgba(0,0,0,0.16); padding: 28px; text-align: center; transform: scale(0.92) translateY(20px); opacity: 0; transition: transform .45s cubic-bezier(.16,1,.3,1), opacity .45s ease; }
  #eizo-booking-widget .eizo-prompt.active .eizo-prompt-card { transform: scale(1) translateY(0); opacity: 1; }
  #eizo-booking-widget .eizo-prompt-close { position: absolute; top: 14px; right: 16px; width: 30px; height: 30px; border: none; background: transparent; border-radius: 50%; cursor: pointer; font-size: 24px; line-height: 1; color: #9CA3AF; transition: color .2s, background .2s; display: flex; align-items: center; justify-content: center; }
  #eizo-booking-widget .eizo-prompt-close:hover { color: #0066CC; background: rgba(0,102,204,0.08); }
  #eizo-booking-widget .eizo-prompt-kicker { color: #0066CC; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 8px; }
  #eizo-booking-widget .eizo-prompt-title { font-size: 19px; font-weight: 600; color: #0B1220; margin: 0 0 12px; line-height: 1.3; }
  #eizo-booking-widget .eizo-prompt-text { color: #5E6A7E; font-size: 14px; line-height: 1.6; margin: 0 0 20px; }
  #eizo-booking-widget .eizo-prompt-cta { display: inline-flex; align-items: center; justify-content: center; padding: 13px 26px; border: none; border-radius: 10px; background: #0066CC; color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; transition: filter .2s, transform .2s; }
  #eizo-booking-widget .eizo-prompt-cta:hover { filter: brightness(1.06); transform: translateY(-1px); }
  #eizo-booking-widget .eizo-prompt-small { color: #8B95A8; font-size: 11px; line-height: 1.5; margin: 14px 0 0; }
  #eizo-booking-widget .eizo-prompt-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  #eizo-booking-widget .eizo-prompt-btn { padding: 12px 24px; border: none; border-radius: 10px; font-size: 14px; font-weight: 600; cursor: pointer; }
  #eizo-booking-widget .eizo-prompt-btn-primary { background: #0066CC; color: #fff; }
  #eizo-booking-widget .eizo-prompt-btn-secondary { background: #F6F8FB; color: #0B1220; }
  #eizo-booking-widget .eizo-mini { position: fixed; left: 24px; bottom: 24px; z-index: 9000; width: 48px; height: 48px; border: none; border-radius: 50%; background: rgba(255,255,255,0.95); color: #0066CC; cursor: pointer; box-shadow: 0 4px 20px rgba(0,102,204,0.15), 0 1px 2px rgba(0,0,0,0.05); display: none; align-items: center; justify-content: center; transform: translateY(20px) scale(0.85); opacity: 0; transition: transform .4s cubic-bezier(.16,1,.3,1), opacity .4s ease, box-shadow .2s; }
  #eizo-booking-widget .eizo-mini.active { display: flex; transform: translateY(0) scale(1); opacity: 1; }
  #eizo-booking-widget .eizo-mini:hover { transform: translateY(-3px) scale(1.08); box-shadow: 0 8px 28px rgba(0,102,204,0.22); }
  #eizo-booking-widget .eizo-mini svg { width: 22px; height: 22px; stroke-width: 1.8; }
  #eizo-booking-widget .eizo-mini-label { position: absolute; left: 58px; bottom: 12px; background: rgba(11,18,32,0.9); color: #fff; font-size: 12px; font-weight: 500; padding: 7px 12px; border-radius: 8px; white-space: nowrap; opacity: 0; transform: translateX(-8px); transition: all .25s ease; pointer-events: none; backdrop-filter: blur(4px); }
  #eizo-booking-widget .eizo-mini:hover .eizo-mini-label { opacity: 1; transform: translateX(0); }
  @media (max-width: 740px) {
    #eizo-booking-widget .eizo-modal { grid-template-columns: 1fr; width: 100%; height: 100%; max-height: 100%; border-radius: 0; }
    #eizo-booking-widget .eizo-sidebar { flex-direction: row; align-items: center; gap: 16px; padding: 20px; flex-wrap: wrap; }
    #eizo-booking-widget .eizo-avatar { width: 64px; height: 64px; font-size: 20px; }
    #eizo-booking-widget .eizo-profile, #eizo-booking-widget .eizo-logos { display: none; }
    #eizo-booking-widget .eizo-mini { left: 16px; bottom: 16px; width: 48px; height: 48px; }
    #eizo-booking-widget .eizo-mini-label { display: none; }
  }
</style>

<div id="eizo-booking-widget">
  <button class="eizo-trigger" id="eizo-trigger" type="button" style="display:none;" aria-hidden="true">📅 Prendre rendez-vous</button>

  <button class="eizo-mini" id="eizo-mini" type="button" aria-label="Prendre rendez-vous">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="3" ry="3"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
    <span class="eizo-mini-label">Prendre rendez-vous</span>
  </button>

  <div class="eizo-prompt" id="eizo-prompt">
    <div class="eizo-prompt-card">
      <button class="eizo-prompt-close" id="eizo-prompt-close" type="button" aria-label="Fermer">×</button>
      <p class="eizo-prompt-kicker">Vous hésitez ?</p>
      <h3 class="eizo-prompt-title">Nous sommes à Paris pour vous aider</h3>
      <p class="eizo-prompt-text">Vous comparez nos moniteurs ColorEdge. C’est normal, chaque usage a ses spécificités. Fred ROL peut vous faire une démonstration et répondre à vos questions.</p>
      <button class="eizo-prompt-cta" id="eizo-prompt-cta" type="button">Choisir un créneau</button>
      <p class="eizo-prompt-small">À Prophot, sans engagement · 1 heure</p>
    </div>
  </div>

  <div class="eizo-backdrop" id="eizo-backdrop">
    <div class="eizo-modal">
      <div class="eizo-sidebar">
        <div class="eizo-avatar" id="eizo-avatar">
          <img src="https://eizo-rendezvous-api-vercel-app.vercel.app/media/image.png" alt="Fred ROL">
        </div>
        <div>
          <p class="eizo-name" id="eizo-name">Fred ROL</p>
          <p class="eizo-specialty" id="eizo-specialty">ColorEdge</p>
        </div>
        <div class="eizo-profile" id="eizo-profile">
          <div class="eizo-profile-section">
            <p class="eizo-profile-line">Rendez-vous 1 heure</p>
            <p class="eizo-profile-line">Paris (Magasin Prophot)</p>
            <p class="eizo-profile-line eizo-mute">Mardi et Vendredi</p>
            <p class="eizo-profile-line eizo-mute">09h30 - 10h30 / 12h - 13h</p>
            <p class="eizo-profile-line eizo-mute">14h - 15h / 16h30 - 17h30</p>
          </div>
          <div class="eizo-profile-section">
            <p class="eizo-profile-label">Votre expert</p>
            <p class="eizo-profile-line">Ingénieur Avant-vente & Après-vente</p>
            <p class="eizo-profile-line">Solutions Graphiques</p>
            <p class="eizo-profile-line">Pre-Sales & After-Sales Graphic Solutions Engineer</p>
          </div>
          <div class="eizo-profile-section">
            <p class="eizo-profile-line"><a href="tel:+33634416976" class="eizo-link">Mobile +33 6 34 41 69 76</a></p>
            <p class="eizo-profile-line"><a href="mailto:fred.rol@feeder.fr" class="eizo-link">fred.rol@feeder.fr</a></p>
            <p class="eizo-profile-line"><a href="mailto:fred@eizo.fr" class="eizo-link">fred@eizo.fr</a></p>
            <p class="eizo-profile-line eizo-mute">12 rue Paul Dautier - 78140 Vélizy Villacoublay</p>
            <p class="eizo-profile-line eizo-mute">Standard +33 4 42 15 84 00</p>
            <p class="eizo-profile-line eizo-mute">www.feeder.fr - www.eizo.fr</p>
          </div>
        </div>
        <div class="eizo-logos" id="eizo-logos">
          <div class="eizo-logos-wrap">
            <img src="https://eizo-rendezvous-api-vercel-app.vercel.app/media/telechargement.png" alt="Feeder - EIZO France" class="eizo-logo">
          </div>
        </div>
      </div>
      <div class="eizo-main">
        <button class="eizo-close" id="eizo-close" type="button" aria-label="Fermer">×</button>

        <div id="eizo-step-calendar">
          <div class="eizo-header">
            <h2>Choisir une date</h2>
            <div class="eizo-nav">
              <button id="eizo-prev" type="button">‹</button>
              <span class="eizo-month" id="eizo-month"></span>
              <button id="eizo-next" type="button">›</button>
            </div>
          </div>
          <div class="eizo-calendar" id="eizo-calendar"></div>
          <div id="eizo-slots"></div>
        </div>

        <form id="eizo-form" class="eizo-form" style="display:none;">
          <button type="button" id="eizo-back" style="background:none;border:none;color:#5E6A7E;cursor:pointer;padding:0;margin-bottom:12px;">← Choisir une autre date</button>
          <h4>Confirmer le rendez-vous</h4>
          <p id="eizo-datetime"></p>
          <div id="eizo-error" class="eizo-error"></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
            <div>
              <label for="eizo-firstName">Prénom *</label>
              <input id="eizo-firstName" name="firstName" required placeholder="Votre prénom">
            </div>
            <div>
              <label for="eizo-lastName">Nom *</label>
              <input id="eizo-lastName" name="lastName" required placeholder="Votre nom">
            </div>
          </div>
          <label for="eizo-email">Email *</label>
          <input id="eizo-email" name="email" type="email" required placeholder="votre@email.com">
          <label for="eizo-phone">Téléphone</label>
          <input id="eizo-phone" name="phone" placeholder="Votre numéro de téléphone">

          <div id="eizo-product-field" style="display:none;">
            <label for="eizo-requested-product">Démonstration souhaitée</label>
            <select id="eizo-requested-product" name="requestedProduct"></select>
          </div>

          <label for="eizo-usage">Votre utilisation</label>
          <select id="eizo-usage" name="customerUsage">
            <option value="">-- Sélectionnez --</option>
            <option value="Photographie">Photographie</option>
            <option value="Vidéo">Vidéo</option>
            <option value="Retouche / post-production">Retouche / post-production</option>
            <option value="Impression / prépresse">Impression / prépresse</option>
            <option value="Graphisme">Graphisme</option>
            <option value="Autre">Autre</option>
          </select>

          <label for="eizo-need">Votre besoin</label>
          <textarea id="eizo-need" name="customerNeed" rows="3" placeholder="Que souhaitez-vous découvrir ou comparer pendant la démonstration ?"></textarea>

          <label for="eizo-notes">Notes / Questions</label>
          <textarea id="eizo-notes" name="notes" rows="3" placeholder="Décrivez votre besoin..."></textarea>
          <button type="submit">Confirmer le rendez-vous</button>
        </form>

        <div id="eizo-success" class="eizo-success" style="display:none;">
          <div class="icon">✓</div>
          <h3>Rendez-vous enregistré</h3>
          <p>Vous recevrez un email de confirmation dès que Fred aura validé votre demande.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  const API_URL = 'https://eizo-rendezvous-api-vercel-app.vercel.app';
  const ORGANIZER_ID = 'coloredge';
  const WORKING_DAYS = [2, 5];
  const HISTORY_LIMIT = 20;
  const DEBOUNCE_MS = 1200;
  const TRIGGER_THRESHOLD = 3;
  const PROMPT_DELAY_MS = 800;
  const WIDGET_VERSION = '2.2';

  const VERSION_KEY = 'eizo_widget_version';
  const SEEN_KEY = 'eizo_seen_coloredge';
  const PROMPT_KEY = 'eizo_prompt_coloredge';

  function resetIfVersionChanged() {
    try {
      const stored = localStorage.getItem(VERSION_KEY);
      if (stored !== WIDGET_VERSION) {
        localStorage.removeItem(SEEN_KEY);
        localStorage.removeItem(PROMPT_KEY);
        localStorage.setItem(VERSION_KEY, WIDGET_VERSION);
        console.log('[EIZO Booking] Cleared legacy tracking for new widget version', WIDGET_VERSION);
      }
    } catch {}
  }

  resetIfVersionChanged();

  const state = {
    currentMonth: new Date(),
    selectedDate: null,
    selectedTime: null,
    selectedEnd: null,
    monthData: {},
    promptOpen: false,
    modalOpen: false,
    processing: false,
    navId: crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random()}`
  };

  const prompt = document.getElementById('eizo-prompt');
  const mini = document.getElementById('eizo-mini');
  const backdrop = document.getElementById('eizo-backdrop');
  const calendarEl = document.getElementById('eizo-calendar');
  const monthEl = document.getElementById('eizo-month');

  function pad(n) { return n.toString().padStart(2,'0'); }
  function formatApiDate(d) { return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; }
  function formatDisplayDate(dateStr) {
    const [y,m,d] = dateStr.split('-').map(Number);
    return new Date(y,m-1,d).toLocaleDateString('fr-FR', { weekday:'long', day:'numeric', month:'long' });
  }
  function formatTime(t) { return (t || '').toString().slice(0,5); }
  function isSlotInPast(dateStr, time) {
    const [y, m, d] = dateStr.split('-').map(Number);
    const [h = 0, min = 0] = (time || '').toString().split(':').map(Number);
    const slot = new Date(y, m - 1, d, h, min);
    return slot < new Date();
  }
  function escapeHtml(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
  }

  const PRODUCT_COLLECTIONS = [{% for c in product.collections %}"{{ c.handle | escape }}"{% unless forloop.last %},{% endunless %}{% endfor %}];

  function isColorEdgePage() {
    const template = {{ template | json }};
    const collection = {{ collection.handle | default: '' | json }};
    const tags = {{ product.tags | default: '' | json }};
    const vendor = {{ product.vendor | default: '' | json }};
    const type = {{ product.type | default: '' | json }};
    const inColoredgeCollection = PRODUCT_COLLECTIONS.some(h => h.toLowerCase().includes('coloredge'));
    const isColoredgeUrl = (window.location.pathname || '').toLowerCase().includes('coloredge');
    return (
      template === 'product' && (inColoredgeCollection || isColoredgeUrl || tags.toLowerCase().includes('coloredge') || vendor.toLowerCase().includes('eizo') || type.toLowerCase().includes('coloredge'))
    ) || (
      template === 'collection' && (collection || '').toLowerCase().includes('coloredge')
    ) || (
      isColoredgeUrl
    );
  }

  function getCurrentProduct() {
    const template = {{ template | json }};
    const productHandle = {{ product.handle | default: '' | json }};
    const productTitle = {{ product.title | default: '' | json }};
    const productId = {{ product.id | default: '' | json }};
    if (template !== 'product' || !isColorEdgePage()) return null;
    return {
      productId: productId ? String(productId).split('/').pop() : undefined,
      handle: productHandle,
      title: productTitle,
      url: window.location.href,
      isProduct: true
    };
  }

  function getCurrentColorEdgeContext() {
    const template = {{ template | json }};
    const collectionHandle = {{ collection.handle | default: '' | json }};
    const collectionTitle = {{ collection.title | default: '' | json }};
    const product = getCurrentProduct();
    if (product) return product;
    if (template === 'collection' && collectionHandle) {
      return {
        productId: undefined,
        handle: collectionHandle,
        title: collectionTitle || collectionHandle,
        url: window.location.href,
        isProduct: false
      };
    }
    if (isColorEdgePage()) {
      return {
        productId: undefined,
        handle: (window.location.pathname || 'coloredge').replace(/^\//, '').replace(/\//g, '-'),
        title: document.title || 'ColorEdge',
        url: window.location.href,
        isProduct: false
      };
    }
    return null;
  }

  function readRawHistory() {
    try { const raw = JSON.parse(localStorage.getItem(SEEN_KEY) || '[]'); return Array.isArray(raw) ? raw : []; } catch { return []; }
  }

  function migrateLegacyHistory(raw) {
    if (!raw.length) return [];
    if (typeof raw[0] === 'object' && raw[0] !== null) return raw;
    return raw
      .filter(item => typeof item === 'string' && item.startsWith('product:'))
      .map((handle, idx) => {
        const clean = handle.replace('product:', '');
        return { handle: clean, title: clean, viewedAt: Date.now() - (raw.length - idx) * 1000 };
      });
  }

  function readColorEdgeVisits() { return migrateLegacyHistory(readRawHistory()); }

  function saveColorEdgeVisits(list) {
    try { localStorage.setItem(SEEN_KEY, JSON.stringify(list.slice(-HISTORY_LIMIT))); } catch {}
  }

  function getColorEdgeVisitCount() { return readColorEdgeVisits().length; }

  function getProductVisitCount() {
    return readColorEdgeVisits().filter(v => v.isProduct === true).length;
  }

  function getLastColorEdgeVisit() {
    const v = readColorEdgeVisits();
    return v[v.length - 1] || null;
  }

  function getUniqueViewedProducts() {
    const v = readColorEdgeVisits();
    const byHandle = {};
    for (const p of v) {
      if (!p.handle || p.isProduct === false) continue;
      const existing = byHandle[p.handle];
      if (!existing || p.viewedAt > existing.viewedAt) {
        byHandle[p.handle] = p;
      }
    }
    return Object.values(byHandle);
  }

  function isTechnicalRevisit() {
    const current = getCurrentColorEdgeContext();
    if (!current) return false;
    const last = getLastColorEdgeVisit();
    if (!last) return false;
    if (last.handle !== current.handle) return false;
    if (last.url !== current.url) return false;
    return (Date.now() - last.viewedAt) < DEBOUNCE_MS;
  }

  function trackColorEdgeVisit() {
    if (!isColorEdgePage()) return;
    const current = getCurrentColorEdgeContext();
    if (!current) return;
    if (isTechnicalRevisit()) return;
    const visits = readColorEdgeVisits();
    visits.push({ ...current, viewedAt: Date.now() });
    saveColorEdgeVisits(visits);
  }

  function readPromptState() {
    try {
      const raw = localStorage.getItem(PROMPT_KEY);
      if (raw === 'yes' || raw === 'accepted') return 'accepted';
      if (raw === 'no' || raw === 'dismissed' || raw === 'shown') return 'dismissed';
      return raw;
    } catch { return null; }
  }

  function savePromptState(value) {
    try { localStorage.setItem(PROMPT_KEY, value); } catch {}
  }

  function shouldAutoShowPrompt() {
    const s = readPromptState();
    if (s === 'dismissed' || s === 'accepted') return false;
    return getColorEdgeVisitCount() >= TRIGGER_THRESHOLD;
  }

  function showPrompt() {
    if (state.promptOpen || state.modalOpen) return;
    state.promptOpen = true;
    prompt.classList.add('active');
    savePromptState('shown');
  }

  function hidePrompt() {
    prompt.classList.remove('active');
    state.promptOpen = false;
  }

  function showMini() { mini.classList.add('active'); }
  function hideMini() { mini.classList.remove('active'); }

  function openModal() {
    state.modalOpen = true;
    hidePrompt();
    backdrop.classList.add('active');
    document.body.style.overflow = 'hidden';
    showCalendar();
  }

  function closeModal() {
    backdrop.classList.remove('active');
    document.body.style.overflow = '';
    state.modalOpen = false;
    const s = readPromptState();
    if (s === 'accepted' || s === 'dismissed') showMini();
  }

  async function fetchSlots(date) {
    const res = await fetch(`${API_URL}/api/public/availability/${encodeURIComponent(ORGANIZER_ID)}?date=${date}&t=${Date.now()}`);
    if (!res.ok) throw new Error('Failed to load slots');
    return res.json();
  }

  async function fetchMonth(year, month) {
    const key = `${year}-${pad(month + 1)}`;
    const res = await fetch(`${API_URL}/api/public/availability/${encodeURIComponent(ORGANIZER_ID)}?month=${key}&t=${Date.now()}`);
    if (!res.ok) throw new Error('Failed to load month');
    const data = await res.json();
    if (data.dates) state.monthData = { ...state.monthData, ...data.dates };
    return data.dates || {};
  }

  function renderProductField() {
    const field = document.getElementById('eizo-product-field');
    const select = document.getElementById('eizo-requested-product');
    const current = getCurrentProduct();
    const unique = getUniqueViewedProducts();
    const options = [];
    if (current && !options.some(o => o.handle === current.handle)) {
      options.push({ ...current, label: current.title || current.handle, current: true });
    }
    for (let i = unique.length - 1; i >= 0; i--) {
      const p = unique[i];
      if (options.some(o => o.handle === p.handle)) continue;
      options.push({ ...p, label: p.title || p.handle, current: false });
    }
    if (!options.length) { field.style.display = 'none'; select.innerHTML = ''; return; }
    field.style.display = 'block';
    select.innerHTML = options.map((p, i) => {
      const suffix = p.current ? ' (produit actuel)' : '';
      return `<option value="${escapeHtml(p.handle)}" ${i === 0 ? 'selected' : ''}>${escapeHtml(p.label)}${suffix}</option>`;
    }).join('');
  }

  function getLastViewedProduct() {
    const v = readColorEdgeVisits();
    for (let i = v.length - 1; i >= 0; i--) {
      if (v[i].isProduct !== false) return v[i];
    }
    return null;
  }

  function getSelectedRequestedProduct() {
    const select = document.getElementById('eizo-requested-product');
    if (!select) return null;
    const handle = select.value;
    return getUniqueViewedProducts().find(p => p.handle === handle) || getCurrentProduct() || getLastViewedProduct();
  }

  async function createBooking(payload) {
    const visits = readColorEdgeVisits();
    const requested = getSelectedRequestedProduct();
    const res = await fetch(`${API_URL}/api/public/bookings`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        organizerId: ORGANIZER_ID,
        ...payload,
        requestedProduct: requested ? {
          productId: requested.productId,
          title: requested.title,
          handle: requested.handle,
          url: requested.url
        } : undefined,
        productsViewed: visits.length ? visits.map(p => ({
          productId: p.productId,
          title: p.title,
          handle: p.handle,
          url: p.url,
          viewedAt: p.viewedAt
        })) : undefined
      })
    });
    const data = await res.json().catch(()=>({}));
    if (!res.ok) throw new Error(data.error || 'Booking failed');
    return data;
  }

  async function renderCalendar(date) {
    const year = date.getFullYear(), month = date.getMonth();
    const first = new Date(year, month, 1), last = new Date(year, month+1, 0);
    const daysInMonth = last.getDate(), startOffset = first.getDay();
    const today = new Date(); today.setHours(0,0,0,0);

    monthEl.textContent = new Date(year, month).toLocaleDateString('fr-FR', { month:'long', year:'numeric' });
    calendarEl.innerHTML = '<p style="color:#5E6A7E;text-align:center;padding:20px;">Chargement du calendrier...</p>';

    try {
      const monthSlots = await fetchMonth(year, month);

      calendarEl.innerHTML = '';
      ['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'].forEach(day => {
        const el = document.createElement('div'); el.className = 'eizo-day-label'; el.textContent = day; calendarEl.appendChild(el);
      });
      for (let i=0; i<startOffset; i++) { const el=document.createElement('div'); el.className='eizo-day empty'; calendarEl.appendChild(el); }

      for (let d=1; d<=daysInMonth; d++) {
        const dateObj = new Date(year, month, d);
        const dateStr = formatApiDate(dateObj);
        const isPast = dateObj < today;
        const isToday = dateObj.getTime() === today.getTime();
        const isWorking = WORKING_DAYS.includes(dateObj.getDay());
        const slots = monthSlots[dateStr] || [];
        const hasAvailable = slots.some(s => s.available && (!isToday || !isSlotInPast(dateStr, s.time || s.start)));
        const el = document.createElement('div');
        el.className = 'eizo-day';
        el.textContent = d;
        if (isPast || !isWorking || !hasAvailable) el.classList.add('disabled');
        else el.addEventListener('click', () => selectDate(dateStr, el));
        if (state.selectedDate === dateStr) el.classList.add('selected');
        calendarEl.appendChild(el);
      }
    } catch {
      calendarEl.innerHTML = '<p style="color:#EF4444;">Impossible de charger le calendrier.</p>';
    }
  }

  async function selectDate(dateStr, el) {
    document.querySelectorAll('#eizo-calendar .eizo-day').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    state.selectedDate = dateStr; state.selectedTime = null; state.selectedEnd = null;
    document.getElementById('eizo-form').style.display = 'none';
    document.getElementById('eizo-success').style.display = 'none';
    const area = document.getElementById('eizo-slots');
    area.innerHTML = '<p style="color:#5E6A7E;">Chargement des créneaux...</p>';
    try {
      const { slots } = await fetchSlots(dateStr);
      const allSlots = slots || [];
      if (allSlots.length === 0) { area.innerHTML = '<p style="color:#5E6A7E;">Aucun créneau pour cette date.</p>'; return; }
      const available = allSlots.filter(s => s.available && !isSlotInPast(dateStr, s.time || s.start));
      const title = available.length === 0 ? 'Aucun créneau disponible' : `${available.length} créneau${available.length>1?'x':''} disponible${available.length>1?'s':''}`;
      area.innerHTML = `<div class="eizo-slots-title">${title}</div><div class="eizo-slots" id="eizo-slots-list"></div>`;
      const list = document.getElementById('eizo-slots-list');
      allSlots.forEach(slot => {
        const start = formatTime(slot.start || slot.time);
        const end = formatTime(slot.end);
        const label = end ? `${start} - ${end}` : start;
        const isPast = isSlotInPast(dateStr, slot.time || slot.start);
        const disabled = !slot.available || isPast;
        const btn = document.createElement('div');
        btn.className = 'eizo-slot' + (disabled ? ' eizo-disabled' : '');
        btn.textContent = label;
        if (slot.available && !isPast) {
          btn.addEventListener('click', () => selectTime(dateStr, slot.time, slot.end));
        }
        list.appendChild(btn);
      });
    } catch { area.innerHTML = '<p style="color:#EF4444;">Impossible de charger les créneaux.</p>'; }
  }

  function selectTime(date, time, end) {
    state.selectedDate = date; state.selectedTime = time; state.selectedEnd = end;
    document.getElementById('eizo-step-calendar').style.display = 'none';
    document.getElementById('eizo-form').style.display = 'block';
    document.getElementById('eizo-success').style.display = 'none';
    const display = state.selectedEnd ? `${formatTime(state.selectedTime)} - ${formatTime(state.selectedEnd)}` : formatTime(state.selectedTime);
    document.getElementById('eizo-datetime').textContent = `${formatDisplayDate(date)} de ${display}`;
    document.getElementById('eizo-error').textContent = '';
    renderProductField();
    document.getElementById('eizo-firstName').focus();
  }

  function showCalendar() {
    document.getElementById('eizo-step-calendar').style.display = 'block';
    document.getElementById('eizo-form').style.display = 'none';
    document.getElementById('eizo-success').style.display = 'none';
    renderCalendar(state.currentMonth);
  }

  document.getElementById('eizo-trigger').addEventListener('click', openModal);
  document.getElementById('eizo-close').addEventListener('click', closeModal);
  backdrop.addEventListener('click', e => { if (e.target === backdrop) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { closeModal(); hidePrompt(); } });

  document.getElementById('eizo-prompt-cta').addEventListener('click', () => { hidePrompt(); savePromptState('accepted'); openModal(); });
  document.getElementById('eizo-prompt-close').addEventListener('click', () => { hidePrompt(); savePromptState('dismissed'); showMini(); });
  prompt.addEventListener('click', e => { if (e.target === prompt) { hidePrompt(); savePromptState('dismissed'); showMini(); } });
  mini.addEventListener('click', openModal);

  document.getElementById('eizo-prev').addEventListener('click', () => { state.currentMonth.setMonth(state.currentMonth.getMonth()-1); renderCalendar(state.currentMonth); });
  document.getElementById('eizo-next').addEventListener('click', () => { state.currentMonth.setMonth(state.currentMonth.getMonth()+1); renderCalendar(state.currentMonth); });
  document.getElementById('eizo-back').addEventListener('click', showCalendar);

  document.getElementById('eizo-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = this.querySelector('button[type="submit"]');
    const original = btn.textContent; btn.disabled = true; btn.textContent = 'Confirmation...';
    document.getElementById('eizo-error').textContent = '';
    try {
      await createBooking({
        date: state.selectedDate,
        time: state.selectedTime,
        customerName: `${document.getElementById('eizo-firstName').value.trim()} ${document.getElementById('eizo-lastName').value.trim()}`,
        customerEmail: document.getElementById('eizo-email').value.trim(),
        customerPhone: document.getElementById('eizo-phone').value.trim() || undefined,
        notes: document.getElementById('eizo-notes').value.trim() || undefined,
        customerUsage: document.getElementById('eizo-usage').value.trim() || undefined,
        customerNeed: document.getElementById('eizo-need').value.trim() || undefined
      });
      this.style.display = 'none';
      document.getElementById('eizo-slots').innerHTML = '';
      document.getElementById('eizo-success').style.display = 'block';
      savePromptState('accepted');
      showMini();
    } catch (err) {
      document.getElementById('eizo-error').textContent = err.message || 'Erreur lors de la réservation.';
    } finally { btn.disabled = false; btn.textContent = original; }
  });

  function shouldTrackForNavigation() {
    try {
      const nav = performance.getEntriesByType('navigation')[0];
      if (!nav) return true;
      // back_forward ne signifie pas forcément bfcache, mais on le traite comme une nouvelle visite
      // si le produit a changé. Le debounce gère les doublons techniques.
      return nav.type !== 'reload' || true;
    } catch { return true; }
  }

  function isCollectionPage() { return {{ template | json }} === 'collection'; }

  function maybeShowPrompt(forceTrack = false) {
    trackColorEdgeVisit();

    const visits = getColorEdgeVisitCount();
    const productVisits = getProductVisitCount();
    const promptState = readPromptState();
    const current = getCurrentColorEdgeContext();

    console.log('[EIZO Booking]', {
      visits,
      productVisits,
      currentContext: current?.handle || null,
      isCollection: isCollectionPage(),
      promptState,
      promptOpen: state.promptOpen,
      modalOpen: state.modalOpen
    });

    if (promptState === 'accepted' || promptState === 'dismissed') {
      showMini();
      return;
    }

    if (!isCollectionPage()) return;

    if (productVisits >= TRIGGER_THRESHOLD && !state.promptOpen && !state.modalOpen && !readPromptState()) {
      setTimeout(() => {
        if (state.promptOpen || state.modalOpen) return;
        if (readPromptState() === 'accepted' || readPromptState() === 'dismissed') return;
        showPrompt();
      }, PROMPT_DELAY_MS);
    }
  }

  window.resetEizoBookingTracking = function () {
    localStorage.removeItem(SEEN_KEY);
    localStorage.removeItem(PROMPT_KEY);
    console.log('[EIZO Booking] Tracking reset');
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => maybeShowPrompt(), { once: true });
  } else {
    maybeShowPrompt();
  }

  // bfcache
  window.addEventListener('pageshow', (e) => {
    console.log('[EIZO Booking] pageshow', { persisted: e.persisted });
    if (e.persisted) maybeShowPrompt(true);
  });

  // Retour / suivant navigateur quand bfcache n'est pas utilisé
  window.addEventListener('popstate', () => {
    console.log('[EIZO Booking] popstate');
    maybeShowPrompt(true);
  });
})();
</script>
