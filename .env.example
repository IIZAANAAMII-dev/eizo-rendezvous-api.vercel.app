# ===================================================================
# EIZO Rendez-vous API
# Feeder SAS - EIZO France
# Variables d'environnement
#
# Développement local : dupliquer ce fichier en .env.local et renseigner les valeurs.
# Production Vercel : configurer les variables dans le dashboard Vercel.
#
# Ne jamais commiter de secrets dans ce fichier.
# ===================================================================


# -------------------------------------------------------------------
# SUPABASE - STOCKAGE TOKEN OAUTH
# -------------------------------------------------------------------
# URL et Service Role Key du projet Supabase.
# Le token OAuth Shopify est stocké automatiquement dans la table shopify_connections.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# -------------------------------------------------------------------
# SHOPIFY - CONFIGURATION
# -------------------------------------------------------------------

# Domaine technique du magasin Shopify.
SHOPIFY_STORE_DOMAIN=eizo-france.myshopify.com

# Client ID et Client Secret pour le flow OAuth Shopify.
# Récupérables depuis Shopify Partner Dashboard > EIZO Rendez-vous > Configuration > Client credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Version de l'API Admin Shopify.
SHOPIFY_API_VERSION=2025-01

# Handle (type) du Metaobject Shopify pour les rendez-vous.
SHOPIFY_METAOBJECT_TYPE=rendez_vous_fred


# -------------------------------------------------------------------
# SERVEUR SMTP
# -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# -------------------------------------------------------------------
# ADRESSES EMAIL
# -------------------------------------------------------------------
EMAIL_FROM=
EMAIL_TO=klegarrec@feeder.fr


# -------------------------------------------------------------------
# ENVIRONNEMENT ET DESTINATAIRE DE TEST
# -------------------------------------------------------------------
# EIZO_ENV=production permet d'envoyer les emails expert au vrai email métier.
# Tout autre valeur (development, preview, test...) redirige les emails expert
# vers EIZO_EXPERT_TEST_EMAIL.
EIZO_ENV=development
EIZO_EXPERT_TEST_EMAIL=klegarrec@feeder.fr


# -------------------------------------------------------------------
# COORDONNÉES DE CONTACT CLIENT
# -------------------------------------------------------------------
# Numéro et email officiels affichés dans les emails clients.
# Laisser vide si non connu : les lignes n'apparaîtront pas.
CONTACT_PHONE=
CONTACT_EMAIL=


# -------------------------------------------------------------------
# URL PUBLIQUE DE L'API
# -------------------------------------------------------------------
# Utilisée pour les liens des emails (boutons Accepter/Refuser) et les pages publiques.
# En local : http://localhost:3000
# En production : https://eizo-rendezvous-api.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=


# ===================================================================
# Important : ne jamais commiter de secrets dans ce fichier.
# ===================================================================
