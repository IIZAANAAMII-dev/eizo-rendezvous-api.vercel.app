{% schema %}
{
  "name": "EIZO Booking Widget",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "organizer_slug",
      "label": "Expert",
      "default": "fred",
      "info": "Le slug de l'organisateur à afficher (ex: fred)"
    },
    {
      "type": "text",
      "id": "api_url",
      "label": "URL de l'API",
      "default": "https://eizo-rendezvous-api-vercel-app.vercel.app",
      "info": "URL de base de votre application Next.js, sans slash final"
    },
    {
      "type": "checkbox",
      "id": "show_popup",
      "label": "Popup automatique",
      "default": true,
      "info": "Affiche automatiquement la popup après le seuil de consultations"
    },
    {
      "type": "range",
      "id": "trigger_threshold",
      "label": "Après",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "info": "Nombre de consultations de produits ColorEdge avant déclenchement"
    },
    {
      "type": "text",
      "id": "coloredge_tag",
      "label": "Tag ColorEdge",
      "default": "coloredge",
      "info": "Tag utilisé pour identifier les produits ColorEdge"
    },
    {
      "type": "checkbox",
      "id": "show_booking_button",
      "label": "Afficher \"Prendre rendez-vous\"",
      "default": true,
      "info": "Affiche un bouton fixe si la popup est désactivée"
    }
  ]
}
{% endschema %}

<script id="eizo-booking-widget-data" type="application/json">
  {
    "productId": {{ product.id | default: '' | json }},
    "productTitle": {{ product.title | default: '' | json }},
    "productHandle": {{ product.handle | default: '' | json }},
    "productTags": {{ product.tags | default: '' | json }},
    "productType": {{ product.type | default: '' | json }},
    "productVendor": {{ product.vendor | default: '' | json }},
    "apiUrl": {{ block.settings.api_url | default: 'https://eizo-rendezvous-api-vercel-app.vercel.app' | json }},
    "organizerId": {{ block.settings.organizer_slug | default: 'fred' | json }},
    "showPopup": {{ block.settings.show_popup | default: true | json }},
    "triggerThreshold": {{ block.settings.trigger_threshold | default: 3 | json }},
    "coloredgeTag": {{ block.settings.coloredge_tag | default: 'coloredge' | json }},
    "showBookingButton": {{ block.settings.show_booking_button | default: true | json }},
    "shopDomain": {{ shop.domain | json }},
    "template": {{ template | json }}
  }
</script>

<script src="{{ 'eizo-booking-widget.js' | asset_url }}" defer></script>
