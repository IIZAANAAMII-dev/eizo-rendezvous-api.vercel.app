# ===================================================================
# EIZO Rendez-vous API
# Feeder SAS - EIZO France
# Variables d'environnement
#
# Ce fichier sert de documentation et de modèle.
# Dupliquer en .env.local pour le développement local.
# Ne jamais commiter de secrets dans ce fichier.
# ===================================================================


# -------------------------------------------------------------------
# SHOPIFY - OAUTH / ADMIN API
# -------------------------------------------------------------------

# Domaine technique du magasin Shopify.
# Format attendu : xxxxx.myshopify.com
# Ne jamais utiliser le domaine public du storefront (ex: eizo.fr).
# Cette valeur se trouve dans l'admin Shopify :
# Paramètres > Détails du magasin > Domaines, ou directement dans l'URL d'administration.
SHOPIFY_STORE_DOMAIN=

# Client ID et Client Secret de l'application Shopify "EIZO Rendez-vous".
# Récupérables dans le Shopify Partner Dashboard :
#   EIZO Rendez-vous > Configuration > Client credentials
# L'application demande les scopes : read_metaobjects, write_metaobjects.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Version stable de l'API Admin Shopify à utiliser.
# Cette valeur pourra être mise à jour lors des évolutions du projet.
SHOPIFY_API_VERSION=2025-01

# Handle (type) du Metaobject Shopify existant utilisé pour stocker les rendez-vous.
# Cette valeur correspond au Metaobject "Rendez-vous Fred" déjà créé dans Shopify.
SHOPIFY_METAOBJECT_TYPE=


# -------------------------------------------------------------------
# SERVEUR SMTP
# -------------------------------------------------------------------
# Utilisé pour envoyer les emails transactionnels suivants :
#   - l'email de nouvelle demande de rendez-vous à Fred ;
#   - l'email de confirmation de rendez-vous au client ;
#   - l'email d'annulation de rendez-vous au client.
# -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# -------------------------------------------------------------------
# ADRESSES EMAIL
# -------------------------------------------------------------------

# Adresse email d'expédition des emails transactionnels (Fred et clients).
EMAIL_FROM=

# Adresse email destinataire de la notification de nouvelle demande (Fred).
EMAIL_TO=


# -------------------------------------------------------------------
# URL PUBLIQUE DE L'API
# -------------------------------------------------------------------
# Cette URL correspond à l'adresse publique de l'API déployée.
# Elle est utilisée pour :
#   - générer les liens des boutons des emails :
#       - "Accepter le rendez-vous"
#       - "Refuser la demande"
#   - définir l'URL de callback OAuth : /api/auth/callback
#
# En local, utiliser un tunnel comme ngrok (ex: https://xxxxx.ngrok-free.app).
# En production : https://eizo-rendezvous-api.vercel.app
# -------------------------------------------------------------------
API_BASE_URL=


# ===================================================================
# Important : ne jamais commiter de secrets dans ce fichier.
# ===================================================================
