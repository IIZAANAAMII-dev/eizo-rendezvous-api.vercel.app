# ===================================================================
# EIZO Rendez-vous API
# Feeder SAS - EIZO France
# Variables d'environnement
#
# Développement local : dupliquer ce fichier en .env.local et renseigner les valeurs.
# Production Vercel : configurer les variables dans le dashboard Vercel.
#
# Ne jamais commiter de secrets dans ce fichier.
# ===================================================================


# -------------------------------------------------------------------
# SHOPIFY - CONFIGURATION PRINCIPALE
# -------------------------------------------------------------------

# Domaine technique du magasin Shopify.
SHOPIFY_STORE_DOMAIN=eizo-france.myshopify.com

# Token Admin API (méthode principale d'authentification).
# Récupérable depuis Shopify Partner Dashboard > EIZO Rendez-vous > API credentials > Reveal token once.
SHOPIFY_ACCESS_TOKEN=

# Version de l'API Admin Shopify.
SHOPIFY_API_VERSION=2025-01

# Handle (type) du Metaobject Shopify pour les rendez-vous.
SHOPIFY_METAOBJECT_TYPE=rendez_vous_fred


# -------------------------------------------------------------------
# SHOPIFY OAUTH (OPTIONNEL - MAINTENANCE SEULEMENT)
# -------------------------------------------------------------------
# Client ID et Client Secret pour le flow OAuth optionnel (/api/auth/install, /api/auth/callback).
# Utilisés uniquement pour l'installation initiale si nécessaire.
# Si SHOPIFY_ACCESS_TOKEN est configuré (recommandé), ces variables ne sont pas requises.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=


# -------------------------------------------------------------------
# SERVEUR SMTP
# -------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


# -------------------------------------------------------------------
# ADRESSES EMAIL
# -------------------------------------------------------------------
EMAIL_FROM=
EMAIL_TO=klegarrec@feeder.fr


# -------------------------------------------------------------------
# URL PUBLIQUE DE L'API
# -------------------------------------------------------------------
# Utilisée pour les liens des emails (boutons Accepter/Refuser).
# En local : http://localhost:3000
# En production : https://eizo-rendezvous-api.vercel.app
API_BASE_URL=


# ===================================================================
# Important : ne jamais commiter de secrets dans ce fichier.
# ===================================================================
